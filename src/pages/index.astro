---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="首页">
  <MainCard
    title="Welcome to WTOTTER's Space"
    description="欢迎来到我个人博客！"
    textOverlay="HOME"
    infoIcon="lucide:info"
    bilibiliLink="https://space.bilibili.com/473143610"
  >
    <div class="space-y-8">
      <section class="py-12">
        <div class="flex flex-col items-center text-center">
          <h1
            class="text-4xl font-bold mb-6 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent leading-loose"
          >
            💠 WTOTTER's Cyber Space
          </h1>
          
          <p class="text-xl text-base-content/80 max-w-3xl mb-12 leading-relaxed">
            欢迎来到我的主站，专门用来记录各种乱七八糟的东西。
          </p>

          <div class="flex flex-wrap gap-6 justify-center">
            <a href="/blog" class="btn btn-primary gap-2 btn-shine-effect px-6">
              <Icon name="lucide:book-open" class="w-5 h-5" />
              <span>浏览文章</span>
            </a>
            
            <a href="/about" class="btn btn-outline gap-2 px-6">
              <Icon name="lucide:user" class="w-5 h-5" />
              <span>关于我</span>
            </a>
          </div>
        </div>
      </section>

      <section class="py-6">
        <div class="card bg-base-200 p-6 border border-base-300 backdrop-blur-md">
          <h2 class="text-xl font-bold mb-4 flex items-center gap-2 text-primary">
            <Icon name="lucide:lightbulb" class="w-6 h-6" />
            <span>关于本站</span>
          </h2>
          <p class="text-base-content/70 leading-loose">
            随便折腾出来的东西：游戏 mod 的过程记录、踩过的坑，还有一些没什么用的想法。
            旧站已经并到这里，以后都在这儿更新。
          </p>
        </div>
      </section>

    </div>
  </MainCard>
</BaseLayout>
