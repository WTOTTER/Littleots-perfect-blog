---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const links = [
  {
    name: "GitHub · WTOTTER",
    desc: "代码和站点源码都在这里。",
    url: "https://github.com/WTOTTER",
    icon: "lucide:github",
  },
  {
    name: "Bilibili",
    desc: "偶尔发点游戏和 mod 相关的东西。",
    url: "https://space.bilibili.com/473143610",
    icon: "simple-icons:bilibili",
  },
  {
    name: "Frosti",
    desc: "这个博客用的 Astro 主题。",
    url: "https://github.com/EveSunMaple/Frosti",
    icon: "simple-icons:astro",
  },
];
---

<BaseLayout title="友链">
  <MainCard
    title="友链与入口"
    description="常去的地方，以及这个站用到的工具。"
    textOverlay="LINKS"
    infoIcon="lucide:link"
  >
    <div class="space-y-6">
      {
        links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card bg-base-200 border border-base-300 p-5 flex flex-row items-center gap-4 hover:bg-base-300 transition-colors"
          >
            <Icon name={l.icon} class="w-8 h-8 text-primary flex-shrink-0" />
            <div>
              <h2 class="text-lg font-bold">{l.name}</h2>
              <p class="text-sm text-base-content/70">{l.desc}</p>
            </div>
          </a>
        ))
      }
      <p class="text-sm text-base-content/60 pt-4">
        想交换友链的话，在 GitHub 上开个 issue 或者直接留言给我就行。
      </p>
    </div>
  </MainCard>
</BaseLayout>
