---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const projects = [
  {
    title: "钢铁雄心 IV · 艾尔吉亚军团",
    tag: "HOI4 Mod",
    desc: "自定义兵种、装备、将领特质与本地化，包含泰坦科技线和配套图标。",
    icon: "lucide:swords",
  },
  {
    title: "十字军之王 3 · 兵种扩展",
    tag: "CK3 Mod",
    desc: "为 CK3 增加兵种与配套定义，顺带排查过 mod 加载顺序冲突。",
    icon: "lucide:crown",
  },
  {
    title: "远行星号 · 艾尔吉亚军团",
    tag: "Starsector Mod",
    desc: "舰长、势力与头像素材，按远行星号的 mod 规范打包。",
    icon: "lucide:rocket",
  },
  {
    title: "Codex API 切换工具",
    tag: "桌面工具",
    desc: "用来在 DeepSeek 与 OpenAI 的 API key 之间快速切换的小工具。",
    icon: "lucide:terminal",
  },
  {
    title: "Littleots-perfect-blog",
    tag: "站点",
    desc: "你现在看到的这个站：Astro + Frosti，部署在 Cloudflare Pages。",
    icon: "lucide:globe",
  },
];
---

<BaseLayout title="项目">
  <MainCard
    title="在折腾什么"
    description="一些 mod、工具和这个站点本身。"
    textOverlay="PROJECTS"
    infoIcon="lucide:code-2"
  >
    <div class="space-y-8">
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          projects.map((p) => (
            <div class="card bg-base-200 border border-base-300 p-6">
              <div class="flex items-center gap-3 mb-3">
                <div class="rounded-full p-3 bg-accent/10">
                  <Icon name={p.icon} class="w-6 h-6 text-primary" />
                </div>
                <div>
                  <h2 class="text-lg font-bold">{p.title}</h2>
                  <span class="text-xs opacity-60">{p.tag}</span>
                </div>
              </div>
              <p class="text-base-content/80 text-sm leading-relaxed">{p.desc}</p>
            </div>
          ))
        }
      </section>

      <div class="flex justify-center">
        <a
          href="https://github.com/WTOTTER"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline gap-2"
        >
          <Icon name="lucide:github" class="w-5 h-5" />
          <span>在 GitHub 上看</span>
        </a>
      </div>
    </div>
  </MainCard>
</BaseLayout>
