---
import { Icon } from "astro-icon/components";
import MainCard from "@/components/MainCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const techStack = [
  { name: "游戏 Mod", icon: "lucide:gamepad-2", color: "oklch(0.7 0.18 145)" },
  { name: "C#", icon: "simple-icons:csharp", color: "oklch(0.6 0.2 160)" },
  { name: "Java", icon: "lucide:coffee", color: "oklch(0.7 0.15 60)" },
  { name: "Python", icon: "simple-icons:python", color: "oklch(0.7 0.2 250)" },
  { name: "JavaScript", icon: "simple-icons:javascript", color: "oklch(0.8 0.2 80)" },
  { name: "Astro", icon: "simple-icons:astro", color: "oklch(0.5 0.2 300)" },
  { name: "TailwindCSS", icon: "simple-icons:tailwindcss", color: "oklch(0.6 0.2 220)" },
  { name: "Android", icon: "lucide:smartphone", color: "oklch(0.7 0.2 150)" },
  { name: "Git", icon: "simple-icons:git", color: "oklch(0.7 0.2 30)" },
  { name: "Photoshop", icon: "simple-icons:adobephotoshop", color: "oklch(0.6 0.2 250)" },
];

const timeline = [
  {
    date: "2026 · 春",
    title: "把这个博客搭起来",
    desc: "用 Astro + Frosti 重做主站，替代原来的 Hexo 后院。",
  },
  {
    date: "2026 · 夏",
    title: "钢铁雄心 IV：艾尔吉亚军团",
    desc: "兵种、装备、特质与本地化，一路修到能进游戏跑。",
  },
  {
    date: "2026 · 秋",
    title: "CK3 与远行星号",
    desc: "给十字军之王 3 写兵种，给远行星号做舰长与势力内容。",
  },
  {
    date: "2026 · 现在",
    title: "小工具与折腾",
    desc: "写了个切换 Codex API 的桌面小工具，顺便继续折腾博客。",
  },
];
---

<BaseLayout title="关于">
  <MainCard
    title="关于 WTOTTER"
    description="写 mod、折腾工具，偶尔写点东西。"
    textOverlay="ABOUT"
    infoIcon="lucide:user"
    bilibiliLink="https://space.bilibili.com/473143610"
  >
    <div class="space-y-10 mb-8">
      <section class="flex flex-col md:flex-row gap-8 items-center md:items-start">
        <div class="avatar">
          <div
            class="w-32 h-32 md:w-40 md:h-40 rounded-xl ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden"
          >
            <img src="/profile.jpg" alt="WTOTTER" width="160" height="160" loading="eager" />
          </div>
        </div>

        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl md:text-4xl font-bold mb-2">WTOTTER</h1>
          <p class="text-xl text-base-content/80 mb-4">游戏 Mod 作者 · 学生</p>

          <div class="flex flex-wrap gap-3 justify-center md:justify-start mb-6">
            <a
              href="https://github.com/WTOTTER"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="lucide:github" class="w-4 h-4" />
              <span>GitHub</span>
            </a>
            <a
              href="https://space.bilibili.com/473143610"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-outline gap-2"
            >
              <Icon name="simple-icons:bilibili" class="w-4 h-4" />
              <span>Bilibili</span>
            </a>
          </div>

          <p class="text-base-content/80 leading-relaxed">
            主要折腾 Paradox 系的游戏 mod：钢铁雄心 IV、十字军之王 3，也碰过远行星号和战舰世界。
            喜欢把一个想法从配置文件一路做到能进游戏跑起来，再顺手写点 Android 和桌面小工具。
            这里放一些过程记录、踩坑和一些没什么用的想法。
          </p>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:code-2" class="w-6 h-6 text-primary" />
          <span>常用的东西</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {
            techStack.map((tech) => (
              <div class="flex flex-col items-center justify-center p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors">
                <div class="text-3xl mb-2" style={`color: ${tech.color}`}>
                  <Icon name={tech.icon} class="w-10 h-10" />
                </div>
                <span class="text-sm font-medium">{tech.name}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <Icon name="lucide:activity" class="w-6 h-6 text-primary" />
          <span>这两年</span>
        </h2>

        <div class="bg-base-200 rounded-xl p-6 overflow-x-auto">
          <div class="flex flex-col md:flex-row gap-8 md:gap-4 md:overflow-x-auto md:pb-2">
            {
              timeline.map((item, i) => (
                <div class="relative flex gap-4 pb-2 md:pb-0 md:min-w-[250px]">
                  <div class="flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-primary-content text-xl">
                      {i + 1}
                    </div>
                    <div class="w-0.5 h-16 bg-base-300 mt-2 md:hidden" />
                  </div>
                  <div>
                    <div class="text-sm text-base-content/60 mb-1">{item.date}</div>
                    <h3 class="text-lg font-bold">{item.title}</h3>
                    <p class="text-base-content/80 mt-1">{item.desc}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </MainCard>
</BaseLayout>
